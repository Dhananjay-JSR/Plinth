{
  "kind": "application",
  "flavor": "sim",
  "version": "1.0",
  "inputs": {
    "kubernetes_details": { "kind": "kubernetes_cluster", "name": "main" }
  },
  "spec": {
    "image": "checkout-api:1.4.0",
    "port": 8080,
    "replicas": 2,
    "env": {
      "LOG_LEVEL": "info",
      "CLUSTER": "${kubernetes_cluster.main.out.default.attributes.cluster_name}"
    }
  }
}
